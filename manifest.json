{
  "manifest_version": 3,
  "name": "MobileDesktopProfileSwitcher",
  "version": "0.1.0",
  "description": "Apply a verified Desktop or Mobile browser profile to user-approved sites without changing the viewport.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "MDPS",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
