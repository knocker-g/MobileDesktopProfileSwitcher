{
  "manifest_version": 3,
  "name": "MobileDesktopProfileSwitcher",
  "version": "0.1.0",
  "description": "Apply a verified Desktop or Mobile browser profile to user-approved sites without changing the viewport.",
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "MDPS",
    "default_popup": "src/ui/popup.html"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
