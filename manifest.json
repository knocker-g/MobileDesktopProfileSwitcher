{
  "manifest_version": 3,
  "name": "Mobile Desktop Profile Switcher",
  "version": "1.0.2",
  "description": "Switch between Default, Desktop, and Mobile browser identity profiles for each site.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mobile Desktop Profile Switcher",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
