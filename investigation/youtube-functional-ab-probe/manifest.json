{
  "manifest_version": 3,
  "name": "YouTube Wire Identity Functional A/B Probe",
  "version": "0.1.0",
  "description": "Investigation-only A-D/S1 probe for minimum YouTube wire identity headers.",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content-diagnostics.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open functional A/B test runner"
  }
}
